# ==============================================================================
# Autonomous PR Testing Engine — Agent Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Model Providers & Dynamic Routing (AWS Strands Agents SDK)
# ------------------------------------------------------------------------------
# Set at least one provider key. If only one key is set, all roles automatically
# route through that provider:
# - Gemini only: Code Reasoning -> gemini-3.8-flash, Vision -> gemini-3.8-flash, Nav -> gemini-3.8-flash
# - Anthropic only: Code Reasoning -> claude-sonnet-4.6, Vision -> claude-sonnet-4.6, Nav -> claude-haiku-4.5

# Anthropic API Key (Claude Sonnet 4.6 & Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# Google Gemini API Key (Gemini 3.8 Flash)
GEMINI_API_KEY=
# Alternate Google API key alias
# GOOGLE_API_KEY=

# Multi-Model Architecture Toggle:
# Set to 'true' to activate specialized multi-model routing (Claude for Code/Nav,
# Gemini for Visual Inspection) when both keys are present. Default: false
ENABLE_MULTI_MODEL=false

# Preferred single-provider when both keys are present and ENABLE_MULTI_MODEL=false:
# 'auto' (default: Anthropic), 'anthropic', 'gemini', or 'bedrock'
DEFAULT_AI_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1b. AWS Bedrock Deployment (IAM Authentication)
# ------------------------------------------------------------------------------
# Automatically active when deployed to AWS (ECS, Lambda, App Runner) without
# third-party keys, or explicitly toggle on:
# USE_BEDROCK=true
# AWS_REGION=us-east-1
# BEDROCK_CODE_MODEL=us.anthropic.claude-sonnet-4-6
# BEDROCK_VISION_MODEL=us.anthropic.claude-sonnet-4-6
# BEDROCK_NAV_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional model identifier overrides:
# CODE_MODEL_ID=claude-sonnet-4.6       # or gemini-3.8-flash
# VISION_MODEL_ID=gemini-3.8-flash      # or claude-sonnet-4.6
# NAV_MODEL_ID=claude-haiku-4.5         # or gemini-3.8-flash


# ------------------------------------------------------------------------------
# 2. Platform Backend & Bridge Daemon
# ------------------------------------------------------------------------------
# Autonomous PR Testing Engine API base URL
PLATFORM_URL=http://localhost:8000

# Local Coding Agent Bridge daemon endpoint
BRIDGE_DAEMON_URL=http://127.0.0.1:8765

# Shared bearer token required on every agent API request (HTTP and WebSocket).
# The API refuses all requests (except GitHub webhooks and /health) if unset.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the AGENT_API_KEY configured for the web app and the bridge CLI/daemon.
AGENT_API_KEY=

# Comma-separated list of origins allowed to make cross-origin requests to this
# API (e.g. the dashboard's public URL). Leave blank for server-to-server-only
# deployments where no browser calls this API directly.
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2b. Sandbox Execution
# ------------------------------------------------------------------------------
# "docker" (default): each run boots a hardened container first, clones the
# target repo INSIDE that container, and runs analysis/install/build/journeys
# against it. Source code never touches host disk — there is no host clone and
# no host git worktree; the container is destroyed (--rm) when the run ends.
# Requires the Docker CLI, a reachable Docker daemon, and the shared toolchain
# image (built once on demand). See docker-compose.yml's docker.sock mount.
# "disabled": skip sandboxing and test whatever is already running on
# localhost:3000 — local development only, NOT safe for untrusted PR code.
SANDBOX_MODE=docker

# Path to the app-under-test's own git checkout, used ONLY when
# SANDBOX_MODE=disabled (no container, so analysis runs against this local
# directory). Defaults to the monorepo's own web/ directory; override in Docker
# to /app/repo/web. Leave blank to use the default.
APP_REPO_DIR=

# Hard ceiling (seconds) on a single pipeline run — in-container clone,
# sandbox boot, all journeys, baseline refresh. Runs are dispatched as
# fire-and-forget background tasks with no external supervisor, so without
# this a hung docker build or wedged browser call would leave a run stuck at
# status=running forever with no explanation.
PIPELINE_TIMEOUT_S=900

# Seconds of that ceiling held back once the route sweep stops, so baseline
# comparison, report generation, artifact upload and the GitHub Check Run still
# happen. The sweep stops starting new routes this long before the hard ceiling.
PIPELINE_REPORT_RESERVE_S=75

# Minimum remaining budget required before a first-run baseline refresh (which
# boots a second sandbox and re-runs the sweep) is started. Below this the run
# keeps the seeded baseline rather than risking the hard timeout.
PIPELINE_BASELINE_MIN_BUDGET_S=180

# How many characters of redacted build/boot output to store with a failed run
# for the dashboard's log viewer. The GitHub comment only shows a short tail.
PIPELINE_BUILD_LOG_CHARS=50000

# ------------------------------------------------------------------------------
# 3. Credential Encryption & Store (AES-256-GCM)
# ------------------------------------------------------------------------------
# Secret used to encrypt test credentials at rest with AES-256-GCM. Any secret
# works (a 32-byte urlsafe base64 Fernet key is used directly; anything else is
# SHA-256 derived), but a generated key is recommended. REQUIRED when
# ENVIRONMENT/APP_ENV is "production" — there is no file fallback there.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_STORE_KEY=

# Path to the encrypted credentials storage file
CREDENTIAL_STORE_PATH=artifacts/credentials.enc

# Local-development only: where the auto-generated key file lives when
# CREDENTIAL_STORE_KEY is unset. Defaults to <store dir>/../.credential_key,
# i.e. OUTSIDE the retained artifacts volume. Ignored in production.
# CREDENTIAL_KEY_PATH=

# ------------------------------------------------------------------------------
# 4. Database & Storage (Supabase PostgreSQL / Local Fallback)
# ------------------------------------------------------------------------------
# Supabase project URL (leave blank to run in seamless local memory/file fallback mode)
SUPABASE_URL=
# Modern Supabase Secret Key (sb_sec_... / sk_...) for elevated backend access
SUPABASE_SECRET_KEY=
# Legacy key aliases (backward compatibility)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=

# ------------------------------------------------------------------------------
# 5. GitHub App Integration (Webhook Ingestion, Check Runs & PR Auto-Fix)
# ------------------------------------------------------------------------------
# GitHub App ID
GITHUB_APP_ID=

# GitHub App Private Key (RS256 PEM file content or inline string)
GITHUB_APP_PRIVATE_KEY=

# Path to PEM private key file (alternative to GITHUB_APP_PRIVATE_KEY)
GITHUB_APP_PRIVATE_KEY_PATH=

# Webhook Secret configured in GitHub App settings for HMAC-SHA256 verification
GITHUB_WEBHOOK_SECRET=

# Personal Access Token fallback for GitHub API testing (optional)
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 6. Decoupled Job Queue & Git Mirror Cache (Worker Pool & Performance)
# ------------------------------------------------------------------------------
# Maximum concurrent Playwright/journey test jobs running simultaneously (Semaphore limit)
MAX_CONCURRENT_JOBS=2

# Directory for caching local bare git mirror repositories (sub-second worktree cloning)
GIT_MIRRORS_DIR=artifacts/mirrors

# ------------------------------------------------------------------------------
# 7. External Target Guard (SSRF)
# ------------------------------------------------------------------------------
# External runs (/runs/external) refuse targets that resolve to a private,
# loopback, link-local or cloud-metadata address. Set true ONLY for a trusted
# self-hosted deployment verifying an app on its own network; it knowingly
# re-enables SSRF from the engine host.
ALLOW_PRIVATE_EXTERNAL_TARGETS=false

# AgentCore invocation shim. /invocations runs real analysis, so it requires the
# bearer token by default. Set true ONLY when a SigV4-authenticating gateway
# sits in front of the engine; otherwise leave false.
AGENTCORE_TRUST_GATEWAY=false

# ------------------------------------------------------------------------------
# 7. Forensic Artifact Retention
# ------------------------------------------------------------------------------
# How long run artifacts (video, trace, screenshots, DOM) are kept on disk AND
# in the private Supabase `run-artifacts` bucket.
ARTIFACT_RETENTION_SECONDS=604800

# How often the background retention sweep runs. Set to 0 to disable it (the
# manual POST /internal/cleanup endpoint remains available either way).
RETENTION_CLEANUP_INTERVAL_SECONDS=21600

# Opt-in: expire DB run rows (the dashboard's history, including the redacted
# DOM/remediation payload inside runs.result) on the same schedule. 0 = keep
# run history forever, which is the default.
RUN_HISTORY_RETENTION_SECONDS=0

# Largest single artifact uploaded to Supabase Storage. Supabase rejects larger
# objects with HTTP 413; oversized traces/videos are skipped and served from the
# local /artifacts route instead of failing. Accepts plain bytes or 50MB/500MB.
# Raise this to match your bucket's per-object limit (50 MiB on the free tier).
MAX_ARTIFACT_UPLOAD_BYTES=50MB

# Playwright trace capture flags. Full traces with screenshots and bundled
# sources are the richest evidence but can push a trace zip past the bucket
# limit; disable both to shrink traces substantially.
PLAYWRIGHT_TRACE_SCREENSHOTS=true
PLAYWRIGHT_TRACE_SOURCES=true

# ------------------------------------------------------------------------------
# 8. Secrets
# ------------------------------------------------------------------------------
# Any secret above may be supplied as a mounted file instead of an env var, by
# setting <NAME>_FILE=/path/to/secret (Docker/K8s secret mounts, systemd
# LoadCredential). An explicit <NAME> always wins. Supported names:
#   AGENT_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY,
#   CREDENTIAL_STORE_KEY, GITHUB_APP_PRIVATE_KEY, GITHUB_TOKEN,
#   GITHUB_WEBHOOK_SECRET, SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   SMTP_PASSWORD
# Example:
# CREDENTIAL_STORE_KEY_FILE=/run/secrets/credential_store_key

# ------------------------------------------------------------------------------
# 9. Three-lane code review & verified fixer
# ------------------------------------------------------------------------------
# `POST /review/fix` runs an agent in a throwaway clone of a repository. That
# endpoint takes a server-side `repo_dir`, so it is confined to these roots;
# unset, the default is the process working directory.
# REVIEW_ALLOWED_ROOTS=/srv/checkouts:/home/ci/repos

# Which candidate generator the fix endpoint uses:
#   miniswe  - the real LLM repair agent (requires provider credentials)
#   scripted - produces no candidate; useful for wiring and tests, and it fails
#              closed rather than proposing an unverified patch
# REVIEW_FIX_GENERATOR=miniswe

# ------------------------------------------------------------------------------
# 10. Outbound email notifications (SMTP)
# ------------------------------------------------------------------------------
# AutoQA emails a repository's watchers when a verification finishes (and what
# failed), when a run produces a finding at or above the configured severity,
# when a three-lane review completes, and when a verified fix is published.
#
# Email is OFF until a host and a sender are both set. Nothing else has to
# change: with SMTP unset, every notification path degrades to a no-op that is
# logged, not an error.
#
# Recipients are resolved per repository, in this order (union):
#   1. a project's own `settings.notifications.recipients` (dashboard)
#   2. `team_members` rows for the repository's GitHub organization
#   3. the Supabase user who imported the project
#   4. NOTIFY_EMAIL_TO below
# A recipient with a Supabase account can additionally opt out of an event for
# themselves (Dashboard → Notifications → My preferences); the workspace-wide
# default policy for repositories that have not overridden it lives in
# `notification_settings.defaults` (Dashboard → Notifications → Global defaults).
# Supabase Auth's own mail (signup confirmation, password reset) is configured
# in the Supabase dashboard and is independent of this section.

# SMTP relay hostname, e.g. smtp.postmarkapp.com / email-smtp.us-east-1.amazonaws.com
SMTP_HOST=
# Port: 587 (STARTTLS) or 465 (implicit TLS) are the common choices.
SMTP_PORT=587
# Username/password for authenticated relays. Leave blank for an internal
# relay that authenticates by IP; an empty username means "do not LOGIN".
SMTP_USERNAME=
SMTP_PASSWORD=
# From address. If SMTP_FROM is unset it falls back to SMTP_USERNAME. Required
# to enable email at all.
SMTP_FROM=
# Display name shown next to the address in most clients.
SMTP_FROM_NAME=AutoQA
# Optional Reply-To for notifications people may want to answer.
# SMTP_REPLY_TO=qa-team@example.com

# Implicit TLS (SMTPS). Set true for port 465. When false, STARTTLS is used.
# SMTP_USE_TLS=false
# Upgrade a plaintext connection with STARTTLS. Defaults to the opposite of
# SMTP_USE_TLS, because doing both is a configuration error on many relays.
# SMTP_STARTTLS=true
# Socket timeout for the SMTP handshake and send, in seconds.
# SMTP_TIMEOUT=15

# Master switch. false stops every notification while keeping the credentials.
# EMAIL_NOTIFICATIONS_ENABLED=true

# Addresses that always receive a copy of every notification (a shared inbox).
# Also the recipient for POST /email/test when no `to` is supplied.
# NOTIFY_EMAIL_TO=qa-team@example.com
# Staging safety: when true, NOTIFY_EMAIL_TO replaces project recipients rather
# than adding to them, so real users cannot receive staging mail.
# NOTIFY_EMAIL_TO_ONLY=false

# Delivery retry policy for the outbox.
# EMAIL_MAX_ATTEMPTS=3
# EMAIL_RETRY_INTERVAL_S=60

# Public dashboard base URL, used to build "Open in AutoQA" links in emails.
# Falls back to APP_ORIGIN when unset.
# DASHBOARD_URL=https://autoqa.example.com


