# ==============================================================================
# Autonomous PR Testing Engine — Web Preview & Telemetry Dashboard (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PR Testing Engine Connection
# ------------------------------------------------------------------------------
# Base URL for the Python FastAPI engine backend (used by Next.js API proxy routes:
# /api/runs, /api/runs/[id]/apply, /api/run-journey)
PLATFORM_URL=http://localhost:8000

# Shared bearer token sent with every server-side proxy request to the engine.
# Must match AGENT_API_KEY in agent/.env. The API proxy routes refuse to call
# the engine (returning a clear error) if this is unset.
AGENT_API_KEY=

# ------------------------------------------------------------------------------
# 2. Seeded Sandbox Test Credentials
# ------------------------------------------------------------------------------
# Seeded test account used for automated Playwright sandbox login (idea.md §3.3).
# Never use real/production credentials. The engine injects these as environment
# variables during sandbox container boot.
TEST_USER_EMAIL=qa@example.com
TEST_USER_PASSWORD=changeme123

# ------------------------------------------------------------------------------
# 3. Supabase Authentication (Preview App & Telemetry)
# ------------------------------------------------------------------------------
# REQUIRED — there is no mock/local-simulation auth mode. The app refuses to
# start serving protected routes if these are unset (see proxy.ts). Create a
# free Supabase project at https://supabase.com to get these values, or point
# at a self-hosted Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. Self-Check Journey
# ------------------------------------------------------------------------------
# Origin this app is served from, used by /api/run-journey for its own
# server-side healthcheck requests. Deliberately NOT derived from the
# incoming request's Host header, which a client can set arbitrarily.
APP_ORIGIN=http://localhost:3000
