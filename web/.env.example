# ==============================================================================
# Autonomous PR Testing Engine — Web Preview & Telemetry Dashboard (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PR Testing Engine Connection
# ------------------------------------------------------------------------------
# Base URL for the Python FastAPI engine backend (used by Next.js API proxy routes:
# /api/runs, /api/runs/[id]/apply, /api/run-journey)
PLATFORM_URL=http://localhost:8000

# Shared bearer token sent with every server-side proxy request to the engine.
# Must match AGENT_API_KEY in agent/.env. The API proxy routes refuse to call
# the engine (returning a clear error) if this is unset.
AGENT_API_KEY=

# GitHub App URL or slug (e.g. "https://github.com/apps/razeqa-engine" or "razeqa-engine").
# Powers the "Install GitHub App" CTAs via /api/github/install,
# and the connect-before-import gate: import is blocked until the signed-in user
# has an installation of this App.
# When unset those CTAs fall back to /login (GitHub OAuth) instead of 404ing.
# Also set the App's Setup URL in GitHub to https://<your-host>/api/github/install/callback
# so an installation returns the user to the import screen.
NEXT_PUBLIC_GITHUB_APP_URL=
GITHUB_APP_URL=
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Server-side equivalent (used if the NEXT_PUBLIC_ variant is unset).
GITHUB_APP_SLUG=
# Import is gated on the App installation by default whenever a GitHub App is
# configured (GITHUB_APP_URL / GITHUB_APP_SLUG / GITHUB_APP_ID).
# Set to "false" ONLY for a single-tenant deployment that deliberately shares one
# installation across every signed-in user.
# GITHUB_APP_REQUIRE_INSTALLATION=false
# The App must be subscribed to the "installation" event: the installer identity
# the gate trusts comes from that webhook's `sender`, so without it nobody can be
# recognised as connected.

# ------------------------------------------------------------------------------
# 2. Seeded Sandbox Test Credentials
# ------------------------------------------------------------------------------
# Seeded test account used for automated Playwright sandbox login (idea.md §3.3).
# Never use real/production credentials. The engine injects these as environment
# variables during sandbox container boot. Leave blank unless you actually need
# them — there are intentionally NO hardcoded fallbacks.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Opt-in only: renders/powers the public one-click "Quick Sandbox Sign In"
# button on /login. Leave unset (or "false") for any public deployment.
# ENABLE_SANDBOX_LOGIN=true
# NEXT_PUBLIC_ENABLE_SANDBOX_LOGIN=true

# Tenant isolation. By default /api/runs and /api/projects only return rows for
# repositories the signed-in user has imported, and ownerless (agent/webhook
# created) rows are hidden. Set to "true" ONLY for a single-tenant self-hosted
# deployment to restore the old permissive behaviour.
# SHOW_UNOWNED_PROJECTS=true

# ------------------------------------------------------------------------------
# 3. Supabase Authentication & Database
# ------------------------------------------------------------------------------
# REQUIRED — there is no mock/local-simulation auth mode. The app refuses to
# start serving protected routes if these are unset (see proxy.ts). Create a
# free Supabase project at https://supabase.com to get these values, or point
# at a self-hosted Supabase stack.
#
# Modern Supabase API Keys:
# - NEXT_PUBLIC_SUPABASE_URL: Your project URL (https://<project-ref>.supabase.co)
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Client-side publishable key (sb_pub_... / pk_...)
# - SUPABASE_SECRET_KEY: Server-only administrative key (sb_sec_... / sk_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Legacy key fallbacks (supported for backward compatibility):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Self-Check Journey
# ------------------------------------------------------------------------------
# Origin this app is served from, used by /api/run-journey for its own
# server-side healthcheck requests. Deliberately NOT derived from the
# incoming request's Host header, which a client can set arbitrarily.
APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Context & Secrets encryption (must match the engine)
# ------------------------------------------------------------------------------
# Key used by web/lib/secrets.ts to encrypt per-repository secrets at rest in the
# v2: AES-256-GCM format. MUST be the identical value configured for the engine
# (CREDENTIAL_STORE_KEY in agent/.env) or a secret saved here cannot be decrypted
# at run time. The Context & Secrets page refuses to save without it; per-repo
# notifications do not use it.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_STORE_KEY=

# ------------------------------------------------------------------------------
# 6. Notifications & email
# ------------------------------------------------------------------------------
# There are NO email variables here. The SMTP transport lives in the engine, so
# SMTP_HOST / SMTP_USERNAME / SMTP_PASSWORD / NOTIFY_EMAIL_TO etc. are configured
# in agent/.env (see agent/.env.example §10). This app only proxies settings to
# the engine and writes notification preferences to Supabase.
# Set DASHBOARD_URL in agent/.env if you want "Open in RazeQA" links in emails;
# it does not fall back to this app's APP_ORIGIN.
