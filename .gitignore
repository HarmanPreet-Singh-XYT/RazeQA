# ==========================================
# Autonomous PR Testing Engine - .gitignore
# ==========================================

# macOS / OS Files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Environment & Secrets (preserve all .env.example files)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!**/.env.example
*.pem
*.key

# Python / uv / Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
env/
venv/
ENV/

# Node.js / Next.js
node_modules/
.next/
out/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Test Runtime Forensic Artifacts (traces, videos, temp screen captures)
artifacts/runs/
artifacts/temp/
agent/artifacts/runs/
agent/artifacts/temp/
*.webm
*.zip

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
