# ==============================================================================
# Autonomous PR Testing & QA Engine — Monorepo Configuration (.env.example)
# ==============================================================================
# Copy this file to agent/.env and web/.env or export these variables into your
# development/CI environment.

# ------------------------------------------------------------------------------
# 1. AI Model Providers & Dynamic Routing (AWS Strands Agents SDK)
# ------------------------------------------------------------------------------
# Set at least one provider key. If only one key is set, all roles automatically
# route through that provider:
# - Gemini only: Code Reasoning -> gemini-3.8-flash, Vision -> gemini-3.8-flash, Nav -> gemini-3.8-flash
# - Anthropic only: Code Reasoning -> claude-sonnet-4.6, Vision -> claude-sonnet-4.6, Nav -> claude-haiku-4.5

# Anthropic API Key (Claude Sonnet 4.6 & Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# Google Gemini API Key (Gemini 3.8 Flash)
GEMINI_API_KEY=
# Alternate Google API key alias
# GOOGLE_API_KEY=

# Multi-Model Architecture Toggle:
# Set to 'true' to activate specialized multi-model routing (Claude for Code/Nav,
# Gemini for Visual Inspection) when both keys are present. Default: false
ENABLE_MULTI_MODEL=false

# Preferred single-provider when both keys are present and ENABLE_MULTI_MODEL=false:
# 'auto' (default: Anthropic), 'anthropic', 'gemini', or 'bedrock'
DEFAULT_AI_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1b. AWS Bedrock Deployment (IAM Authentication)
# ------------------------------------------------------------------------------
# Automatically active when deployed to AWS (ECS, Lambda, App Runner) without
# third-party keys, or explicitly toggle on:
# USE_BEDROCK=true
# AWS_REGION=us-east-1
# BEDROCK_CODE_MODEL=us.anthropic.claude-sonnet-4-6
# BEDROCK_VISION_MODEL=us.anthropic.claude-sonnet-4-6
# BEDROCK_NAV_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional model identifier overrides:
# CODE_MODEL_ID=claude-sonnet-4.6       # or gemini-3.8-flash
# VISION_MODEL_ID=gemini-3.8-flash      # or claude-sonnet-4.6
# NAV_MODEL_ID=claude-haiku-4.5         # or gemini-3.8-flash


# ------------------------------------------------------------------------------
# 2. Platform & Bridge Daemon Endpoints
# ------------------------------------------------------------------------------
# Python FastAPI engine base URL (default: http://localhost:8000)
PLATFORM_URL=http://localhost:8000

# Local Coding Agent Bridge daemon endpoint (default: http://127.0.0.1:8765)
BRIDGE_DAEMON_URL=http://127.0.0.1:8765

# Shared bearer token required on every agent API request. Must be identical
# across agent/.env, web/.env, and the bridge CLI/daemon environment — the API
# refuses all requests (except GitHub webhooks and /health) if unset.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Comma-separated origins allowed to call the agent API cross-origin (browser
# callers only — leave blank for server-to-server-only deployments).
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 3. Test Credential Encryption (AES-256 Fernet)
# ------------------------------------------------------------------------------
# Key for encrypting stored test credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, an ephemeral development key is automatically generated.
CREDENTIAL_STORE_KEY=
CREDENTIAL_STORE_PATH=artifacts/credentials.enc

# ------------------------------------------------------------------------------
# 4. Preview Sandbox Seeded Test Account
# ------------------------------------------------------------------------------
# Seeded test account injected into sandbox preview apps for automated login flows.
# Leave blank unless you have provisioned a dedicated test user — there are
# intentionally NO hardcoded fallback credentials.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Opt-in only: enables the public one-click sandbox sign-in on /login.
# ENABLE_SANDBOX_LOGIN=true

# ------------------------------------------------------------------------------
# 5. Database & Cloud Telemetry (Supabase PostgreSQL / Local Fallback)
# ------------------------------------------------------------------------------
# REQUIRED for a production deployment — apply supabase/schema.sql to your
# Supabase project first. Without these, the agent backend falls back to
# in-memory/file storage (data lost on restart, fine for local dev only) and
# the web dashboard refuses to serve protected routes at all (no mock/bypass
# auth mode — see web/proxy.ts).
#
# Modern Supabase keys: Secret Key for engine backend, Publishable Key for dashboard
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key fallbacks (backward compatible):
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 6. GitHub App Integration (Webhooks, Check Runs, PR Comments & Auto-Fix)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Path to PEM private key file (alternative to inline GITHUB_APP_PRIVATE_KEY)
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# App URL slug (github.com/apps/<slug>). Required by the "Install GitHub App"
# CTAs and by the connect-before-import gate: with no slug there is nothing to
# redirect the user to.
GITHUB_APP_SLUG=
# Import is gated on the App installation by default whenever a GitHub App is
# configured. Set to false only for a single-tenant deployment that deliberately
# shares one installation across every signed-in user.
# GITHUB_APP_REQUIRE_INSTALLATION=false
# Personal Access Token fallback for GitHub API testing (optional)
# GITHUB_TOKEN=
#
# GitHub App settings to configure alongside these variables:
#   * Setup URL: <deployment>/api/github/install/callback
#     Returns the user to the import screen after installing.
#   * Subscribe to the "installation" event. It is the only source of the
#     installer identity the import gate trusts (the webhook `sender`), so
#     without it no account can be recognised as connected.

# ------------------------------------------------------------------------------
# 7. Job Queue & Git Mirror Caching (Worker Pool & Performance)
# ------------------------------------------------------------------------------
# Maximum concurrent Playwright/journey test jobs running in parallel (Semaphore limit)
MAX_CONCURRENT_JOBS=2

# Directory for caching local bare git mirror repositories (sub-second worktree cloning)
GIT_MIRRORS_DIR=artifacts/mirrors

# ------------------------------------------------------------------------------
# 8. External Target Guard (SSRF)
# ------------------------------------------------------------------------------
# External runs refuse targets that resolve to a private, loopback, link-local or
# cloud-metadata address. Set this to true ONLY for a trusted self-hosted
# deployment that needs to verify an app on its own network: it knowingly
# re-enables server-side request forgery from the engine host. Never enable it
# where external targets come from untrusted users.
ALLOW_PRIVATE_EXTERNAL_TARGETS=false

# AgentCore invocation shim. /invocations runs real analysis, so it requires the
# bearer token by default. Set true ONLY when a SigV4-authenticating gateway
# sits in front of the engine; otherwise leave false.
AGENTCORE_TRUST_GATEWAY=false

# ------------------------------------------------------------------------------
# 9. Outbound Email Notifications (SMTP)
# ------------------------------------------------------------------------------
# Off until SMTP_HOST and SMTP_FROM are both set. Recipients are resolved per
# repository from team_members, the project owner, and NOTIFY_EMAIL_TO. Per-repo
# overrides, workspace defaults, personal opt-outs and the team list are managed
# in the dashboard (Dashboard -> Notifications) and stored in Supabase.
# See agent/.env.example §10 for the full explanation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AutoQA
# SMTP_REPLY_TO=qa-team@example.com
# SMTP_USE_TLS=false
# SMTP_STARTTLS=true
# SMTP_TIMEOUT=15
# EMAIL_NOTIFICATIONS_ENABLED=true
# NOTIFY_EMAIL_TO=qa-team@example.com
# NOTIFY_EMAIL_TO_ONLY=false
# EMAIL_MAX_ATTEMPTS=3
# EMAIL_RETRY_INTERVAL_S=60
# DASHBOARD_URL=https://autoqa.example.com

